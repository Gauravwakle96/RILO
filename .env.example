# Keep .env private. The local app never sends credential values to the browser.
RILO_DATA_DIR=.rilo
RILO_BIFROST_URL=http://127.0.0.1:8086
RILO_MODEL=ollama/qwen2.5-coder:7b
RILO_PORT=8018
# Explicit model-token rate map. Omit rates to keep API fees unknown.
# Example for a verified local provider: {"ollama/qwen2.5-coder:7b":{"input_usd_per_million":0,"output_usd_per_million":0}}
RILO_MODEL_PRICING_JSON={}
# Only required for live Tavily research. Controlled synthetic evidence is available offline.
TAVILY_API_KEY=
# Optional local Bifrost virtual key, never included in traces.
BIFROST_API_KEY=
# User-defined safety allowance; live admission reserves the configured upper bound.
RILO_TAVILY_CREDIT_LIMIT=900
# Optional authorized read access to private GitHub repositories. Never sent to agents.
GITHUB_TOKEN=
# Optional preinstalled Docker image digest for isolated repository tests.
RILO_SANDBOX_IMAGE=
# Conservative serialized prompt byte cap. Increase only with validated model context.
RILO_WORKSPACE_INPUT_BYTES=6000
# Combined private uploaded files and source objects; default 512 MB.
RILO_STORAGE_MAX_BYTES=512000000
